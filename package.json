{
  "name": "@jswork/wk-bridge",
  "version": "1.0.0",
  "description": "Promise-based H5 bridge for WKWebView: typed calls, events, zero dependencies.",
  "npmClient": "pnpm",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "prettier": "@jswork/style-guide/prettier",
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "release": "release-it",
    "prepublishOnly": "pnpm build && bun test"
  },
  "license": "MIT",
  "devDependencies": {
    "@jswork/style-guide": "^1.0.3",
    "@jswork/tsup-banner": "^1.0.4",
    "@swc/core": "^1.5.5",
    "@types/node": "^20.12.11",
    "prettier": "^3.3.3",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "homepage": "https://github.com/afeiship/wk-bridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afeiship/wk-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/afeiship/wk-bridge/issues"
  },
  "keywords": [
    "wkwebview",
    "webview",
    "bridge",
    "h5",
    "hybrid",
    "ios",
    "macos",
    "swift",
    "promise",
    "rpc",
    "typescript"
  ]
}
